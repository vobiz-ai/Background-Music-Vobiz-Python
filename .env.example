# ── Vobiz credentials ─────────────────────────────────────────────────────────
VOBIZ_AUTH_ID=MA_XXXXXXXXXXXXXXXXXXXXXXXXXX   # Your Vobiz account auth ID
VOBIZ_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX     # Your Vobiz account auth token

# ── Phone numbers ─────────────────────────────────────────────────────────────
FROM_NUMBER=+15550003333                      # Your Vobiz DID (caller ID for outbound)

# ── Background audio ──────────────────────────────────────────────────────────
# URL of the audio file mixed into the call (MP3 or WAV).
# Must be publicly reachable over HTTPS. Vobiz loops it natively via loop=true,
# so no loop interval needs to be configured here.
BACKGROUND_AUDIO_URL=https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3

# ── Server ────────────────────────────────────────────────────────────────────
HTTP_PORT=8000
PUBLIC_URL=                                   # Set for EC2/production — skips ngrok
NGROK_AUTH_TOKEN=                             # Optional ngrok auth token for local dev
